EXPO_PUBLIC_API_URL=http://localhost:3002/api/v1
EXPO_PUBLIC_WEB_URL=https://safetag.app
# Optional fallback: Android native Google map key (used when Mapbox token is not set)
GOOGLE_MAPS_API_KEY=
# Required for Mapbox runtime map rendering
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Required for Expo prebuild/EAS native dependency download (DOWNLOADS:READ scope)
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Google OAuth (use the Android/iOS client ID from Google Cloud Console)
# Web client ID is for browser flows; native client ID is for Expo/React Native
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
