# API
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# Mapbox basemap (same public pk.* token as mobile EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Shopify Admin domain for order deep-links (your-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Storefront URL for the Shop button on My Tags (custom domain or https://your-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_SHOP_URL=

# HMAC secret for Pro travel-guide access codes (/guides/{city}/{uniqueCode})
GUIDE_ACCESS_SECRET=
