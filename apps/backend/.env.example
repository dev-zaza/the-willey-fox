# Optional overrides. Canonical env is ../../.env (safetag/.env) — that file loads first.
# Application
NODE_ENV=development
PORT=3002
PUBLIC_BASE_URL=http://127.0.0.1:3001
API_BASE_URL=http://localhost:3000/api/v1

# Database (PostgreSQL) — match safetag/.env / docker-compose (Postgres host port 5433)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=safetag
DATABASE_PASSWORD=safetag_dev
DATABASE_NAME=safetag_dev
DATABASE_URL=postgresql://safetag:safetag_dev@localhost:5433/safetag_dev
# Supabase on Render / IPv4-only hosts: use Session pooler URI (Connect → Session), NOT direct db.*.supabase.co
# (direct resolves to IPv6 → ENETUNREACH). *.pooler.supabase.com:5432 works with this API (prepare: false).

# Redis — use REDIS_URL when your host provides one (e.g. Render Key Value); it overrides host/port.
# REDIS_URL=redis://red-xxxxx:6379
# Local docker-compose (host port 6380):
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# Email Provider (smtp | ses | sendgrid | console)
EMAIL_PROVIDER=smtp

# Gmail SMTP (use an App Password, NOT your account password)
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail"
# 4. Paste the 16-character password as SMTP_PASS below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=TheWileyfox <youraddress@gmail.com>
EMAIL_FROM=TheWileyfox <youraddress@gmail.com>

# SMS Provider (twilio | vonage | sns | console)
SMS_PROVIDER=console

# Twilio (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_MESSAGING_SERVICE_SID=

# Notifications
# HMAC-SHA256 secret for generating one-click unsubscribe tokens (must be strong random string)
NOTIFICATIONS_UNSUBSCRIBE_SECRET=change-me-in-production

# Push Provider (fcm | console)
PUSH_PROVIDER=console

# FCM (required when PUSH_PROVIDER=fcm)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# CORS — comma-separated browser origins allowed to call the API (scheme + host + port, no path)
# Local web + Expo; add production frontend URL(s), e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# redirect_uri_mismatch → GOOGLE_CALLBACK_URL must match Google Console "Authorized redirect URIs" byte-for-byte (https, no trailing slash).
# This is the API host + path (where Google sends the user back), not the Next.js URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Production example: https://your-api.onrender.com/api/v1/auth/google/callback
# Mobile app deep-link scheme — must match apps/mobile/app.json "scheme"
MOBILE_APP_SCHEME=thewileyfox

# App name (used in TOTP QR code issuer label)
APP_NAME=TheWileyfox

# Cloudinary (avatar uploads — https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mapbox (required for directions/route feature)
MAPBOX_ACCESS_TOKEN=

# Shopify (optional — used for QR fulfillment webhook)
SHOPIFY_WEBHOOK_SECRET=
