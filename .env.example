# =============================================================================
# Which .env does the backend use?
# NestJS loads (apps/backend) in order — first file wins for duplicate keys:
#   1) safetag/.env
#   2) safetag/apps/backend/.env
# Put shared config in safetag/.env. Use apps/backend/.env only for local overrides.
#
# Next.js uses apps/web/.env.local (NEXT_PUBLIC_*); it does not read safetag/.env.
#
# After Google OAuth you see ERR_FAILED on localhost:3001 = no process is listening
# on 3001 (web dev not running). Run: pnpm --filter @safetag/web dev
# =============================================================================

# Application
NODE_ENV=development
PORT=3002
# Public web app URL (Next.js) — OAuth redirect target (port 3001).
# Prefer 127.0.0.1: many systems resolve "localhost" to IPv6 (::1) while dev only listened on IPv4 → ERR_FAILED.
PUBLIC_BASE_URL=http://127.0.0.1:3001

# Database (PostgreSQL)
# With docker-compose: Postgres is published on host port 5433 (see docker-compose.yml).
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=safetag
DATABASE_PASSWORD=safetag_dev
DATABASE_NAME=safetag_dev
DATABASE_URL=postgresql://safetag:safetag_dev@localhost:5433/safetag_dev

# Admin panel seed (run: pnpm --filter @safetag/backend db:seed-admin)
# Defaults: admin@localhost.dev / ChangeMeAdmin123! — override in production.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=
ADMIN_SEED_LAST_NAME=

# Redis
# With docker-compose: Redis is published on host port 6380 (see docker-compose.yml).
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
ACCESS_TOKEN_EXPIRY_MINUTES=10080
REFRESH_TOKEN_EXPIRY_DAYS=30

# Email Provider (smtp | ses | sendgrid | console)
EMAIL_PROVIDER=smtp

# SMTP (Ethereal for dev — https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safetag.app

# SMS Provider (twilio | vonage | sns | console)
SMS_PROVIDER=console

# Twilio (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Push Provider (fcm | console)
PUSH_PROVIDER=console

# FCM (required when PUSH_PROVIDER=fcm)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# CORS (comma-separated; include every browser origin you use, e.g. 127.0.0.1 vs localhost)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/api/v1/auth/google/callback

# App name (used in TOTP QR code issuer label)
APP_NAME=TheWileyfox

# Cloudinary (avatar uploads — https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mapbox
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# FBI Crime Data API (free with data.gov key — https://api.data.gov/signup)
FBI_API_KEY=

# Stripe (use test keys for development — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_ID_ANNUAL=price_your_annual_price_id
# 7-day free trial in days
STRIPE_TRIAL_DAYS=7

# Shopify webhook (physical QR tag purchases)
# HMAC secret from Shopify Admin → Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here
# Shopify Admin API credentials (for batch lookups / order management)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Optional: filter line items by this Shopify product ID (leave blank to count all items)
SHOPIFY_QR_PRODUCT_ID=
# Web app: used to generate deep-links to Shopify orders in admin panel
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Frontend env (web app)
# Set on web app — must match STRIPE_PRICE_ID_ANNUAL above for interval detection
NEXT_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_your_annual_price_id

# Sentry (error tracking — https://sentry.io/settings/<org>/projects/<project>/keys/)
SENTRY_DSN=
# Required for source map upload during CI/CD builds
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Frontend Sentry (Next.js — must be NEXT_PUBLIC_ prefix to reach browser)
NEXT_PUBLIC_SENTRY_DSN=

# Mobile Sentry (Expo — must be EXPO_PUBLIC_ prefix to reach JS bundle)
EXPO_PUBLIC_SENTRY_DSN=

# ── Safety Engine: Data Connectors ──────────────────────────────────────────
# ACLED conflict data (sign up at https://developer.acleddata.com/)
ACLED_API_KEY=
ACLED_EMAIL=

# UNODC intentional homicide CSV URL (changes yearly — check dataunodc.un.org)
UNODC_HOMICIDE_URL=https://dataunodc.un.org/sites/dataunodc.un.org/files/data_cts_intentional_homicide.csv

# Set to 1 to skip all DB writes during local testing / CI
DRY_RUN=
